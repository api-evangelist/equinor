           {
            "datasetId": "01.01",
            "npdRequirement": "Mandatory",
            "dataset": "Composite",
            "definition": "\n            The Composite Log should contain all the primary measurements made in a given well/wellbore. \n            A primary measurement may be composed of data taken from different physical tools (e.g. a combination of wireline and MWD measurements).\n            ",
            "unloadFilePath": "WELL_qqqq_bb-i-nn/WB_sRrYyHTt_xxxx-Pz/COMPOSITE",
